# Copy to .env.local and fill in. Never commit real values.

# Supabase project (public values: the anon key is meant for browsers, access is decided by row-level security)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Sign-in bot check (Cloudflare Turnstile). The site key is public; the secret is server-only (set it in Vercel, never commit it).
# A production build without TURNSTILE_SECRET_KEY refuses every sign-in on purpose.
NEXT_PUBLIC_TURNSTILE_SITE_KEY=
TURNSTILE_SECRET_KEY=

# TEST ONLY: turns the idle logout on (5 to 1800 seconds). Leave unset in real deployments (off by default).
# IDLE_LIMIT_SECONDS=

# NEVER put the Supabase service-role key here: the portal acts as the signed-in staff member only.
